WP_ENVIRONMENT_TYPE=local

DB_NAME=coins
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1:8889

# Generate a strong random string (e.g.: openssl rand -base64 48)
JWT_AUTH_SECRET_KEY=

# Comma-separated list of origins allowed to call the REST/GraphQL API (CORS).
# Falls back to http://localhost:5173 (r-numismat dev server) if unset.
COINS_ALLOWED_ORIGINS=http://localhost:5173